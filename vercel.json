{
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/whiteboard", "destination": "https://675whiteboard.vercel.app/whiteboard" },
    { "source": "/whiteboard/", "destination": "https://675whiteboard.vercel.app/whiteboard/" },
    { "source": "/whiteboard/:path*", "destination": "https://675whiteboard.vercel.app/whiteboard/:path*" },
    { "source": "/planner", "destination": "https://675planner.vercel.app/planner" },
    { "source": "/planner/", "destination": "https://675planner.vercel.app/planner/" },
    { "source": "/planner/:path*", "destination": "https://675planner.vercel.app/planner/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
