rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return isSignedIn() && userData().rol == 'superadmin';
    }

    function isCoordinador() {
      return isSignedIn() && userData().rol == 'coordinador';
    }

    function isEntrenador() {
      return isSignedIn() && userData().rol == 'entrenador';
    }

    function isClubStaff() {
      return isCoordinador() || isEntrenador();
    }

    function userClubId() {
      return userData().clubId;
    }

    function belongsToClub(clubId) {
      return isSignedIn() && userClubId() == clubId;
    }

    function equipoClubId(equipoId) {
      return get(/databases/$(database)/documents/Equipos/$(equipoId)).data.clubId;
    }

    function canAccessEquipo(equipoId) {
      return isSuperadmin() || belongsToClub(equipoClubId(equipoId));
    }

    function canManageEquipoClub(clubId) {
      return isSuperadmin() || (isCoordinador() && userClubId() == clubId);
    }

    function validFavoritosValue() {
      let favs = request.resource.data.equiposFavoritos;
      return favs is list
        && favs.size() <= 2
        && (
          favs.size() == 0
          || (
            favs[0] is string
            && favs[0].size() > 0
            && favs[0].size() <= 80
          )
        )
        && (
          favs.size() < 2
          || (
            favs[1] is string
            && favs[1].size() > 0
            && favs[1].size() <= 80
            && favs[0] != favs[1]
          )
        );
    }

    function validEquiposFavoritosUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['equiposFavoritos']) || validFavoritosValue();
    }

    function coachSelfUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isCoordinador()
        ? changed.hasOnly(['nombre', 'equiposFavoritos'])
        : changed.hasOnly(['nombre', 'solicitudClubId', 'solicitudClubNombre', 'equiposFavoritos'])
          && !changed.hasAny(['clubId', 'clubNombre', 'rol']);
    }

    function validUserProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['nombre'])
        || (
          request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 80
        );
    }

    function validUserCreate() {
      let keys = request.resource.data.keys();
      return keys.hasOnly(['email', 'rol', 'creadoEn', 'nombre'])
        && request.resource.data.rol == 'entrenador'
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && (
          !keys.hasAny(['nombre'])
          || (
            request.resource.data.nombre is string
            && request.resource.data.nombre.size() > 0
            && request.resource.data.nombre.size() <= 80
          )
        );
    }

    match /Usuarios/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isSuperadmin()
        || (isClubStaff() && resource.data.clubId == userClubId())
      );
      allow create: if isSignedIn() && request.auth.uid == userId && validUserCreate();
      allow update: if isSuperadmin() || (
        isSignedIn() && request.auth.uid == userId && coachSelfUpdateAllowed() && validUserProfileUpdate() && validEquiposFavoritosUpdate()
      ) || (
        isCoordinador()
        && resource.data.clubId == userClubId()
        && request.resource.data.clubId == resource.data.clubId
        && resource.data.rol != 'superadmin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equiposFavoritos'])
        && validFavoritosValue()
      );
      allow delete: if isSuperadmin();
    }

    match /Clubes/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSuperadmin();
      allow update: if isSuperadmin() || (
        isCoordinador()
        && userClubId() == clubId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logoUrl', 'logoSource', 'logoUpdatedAt'])
      );
      allow delete: if isSuperadmin();
    }

    match /Equipos/{equipoId} {
      allow read: if isSignedIn() && (isSuperadmin() || resource.data.clubId == userClubId());
      allow create: if isSignedIn() && canManageEquipoClub(request.resource.data.clubId);
      allow update, delete: if canManageEquipoClub(resource.data.clubId);
    }

    match /Jugadoras/{jugadoraId} {
      allow read: if isSignedIn() && (
        isSuperadmin() || canAccessEquipo(resource.data.equipoId)
      );
      allow create: if isSignedIn() && (
        isSuperadmin() || (
          belongsToClub(request.resource.data.clubId)
          && canAccessEquipo(request.resource.data.equipoId)
        )
      );
      allow update, delete: if isSignedIn() && (
        isSuperadmin() || (
          belongsToClub(resource.data.clubId)
          && canAccessEquipo(resource.data.equipoId)
        )
      );
    }

    match /Sesiones/{sesionId} {
      allow read: if isSignedIn() && (isSuperadmin() || canAccessEquipo(resource.data.equipoId));
      allow create: if isSignedIn() && canAccessEquipo(request.resource.data.equipoId);
      allow update: if isSignedIn() && canAccessEquipo(resource.data.equipoId);
      allow delete: if isSignedIn() && canAccessEquipo(resource.data.equipoId);
    }

    match /Logos/{logoId} {
      allow read: if isSignedIn() && (
        isSuperadmin()
        || resource.data.tipo == 'club'
        || resource.data.clubId == userClubId()
      );
      allow create, update: if isSignedIn() && (
        isSuperadmin()
        || (
          isCoordinador()
          && request.resource.data.clubId == userClubId()
          && (
            request.resource.data.tipo == 'club'
            || request.resource.data.tipo == 'equipo'
          )
        )
      );
      allow delete: if isSuperadmin()
        || (isCoordinador() && resource.data.clubId == userClubId());
    }
  }
}
