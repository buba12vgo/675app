rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return isSignedIn() && userData().rol == 'superadmin';
    }

    function isCoordinador() {
      return isSignedIn() && userData().rol == 'coordinador';
    }

    function isEntrenador() {
      return isSignedIn() && userData().rol == 'entrenador';
    }

    function isPreparadorFisico() {
      return isSignedIn() && userData().rol == 'preparador_fisico';
    }

    function isClubStaff() {
      return isCoordinador() || isEntrenador() || isPreparadorFisico();
    }

    function isCoachStaff() {
      return isCoordinador() || isEntrenador();
    }

    function userClubId() {
      return userData().clubId;
    }

    function belongsToClub(clubId) {
      return isSignedIn() && userClubId() == clubId;
    }

    function equipoClubId(equipoId) {
      return get(/databases/$(database)/documents/Equipos/$(equipoId)).data.clubId;
    }

    function canAccessEquipo(equipoId) {
      return isSuperadmin() || belongsToClub(equipoClubId(equipoId));
    }

    function canManageEquipoClub(clubId) {
      return isSuperadmin() || (isCoordinador() && userClubId() == clubId);
    }

    function canManagePlantillaEquipo(equipoId) {
      return isSuperadmin() || (isCoachStaff() && canAccessEquipo(equipoId));
    }

    function sesionTipo(data) {
      return data.tipo == 'partido' ? 'partido'
        : (data.tipo == 'fisico' ? 'fisico' : 'entreno');
    }

    function canWriteSesionTipo(tipo) {
      return isSuperadmin()
        || isCoordinador()
        || isEntrenador()
        || (isPreparadorFisico() && tipo == 'fisico');
    }

    function validLogoPayload(logoId) {
      let d = request.resource.data;
      return d.clubId is string
        && d.entityId is string
        && d.entityId.size() > 0
        && (
          (
            d.tipo == 'club'
            && logoId == ('club_' + d.clubId)
            && d.entityId == d.clubId
          ) || (
            d.tipo == 'equipo'
            && logoId == ('equipo_' + d.entityId)
            && equipoClubId(d.entityId) == d.clubId
          )
        );
    }

    function canWriteLogo(logoId) {
      return isSignedIn()
        && validLogoPayload(logoId)
        && (
          isSuperadmin()
          || (
            isCoordinador()
            && request.resource.data.clubId == userClubId()
          )
        );
    }

    function validFavoritoId(favs, i) {
      return favs[i] is string
        && favs[i].size() > 0
        && favs[i].size() <= 80;
    }

    function maxFavoritosAllowed() {
      return request.resource.data.rol == 'preparador_fisico' ? 10 : 4;
    }

    function validFavoritosValue() {
      let favs = request.resource.data.equiposFavoritos;
      let max = maxFavoritosAllowed();
      return favs is list
        && favs.size() <= max
        && (favs.size() == 0 || validFavoritoId(favs, 0))
        && (favs.size() < 2 || validFavoritoId(favs, 1))
        && (favs.size() < 3 || validFavoritoId(favs, 2))
        && (favs.size() < 4 || validFavoritoId(favs, 3))
        && (favs.size() < 5 || validFavoritoId(favs, 4))
        && (favs.size() < 6 || validFavoritoId(favs, 5))
        && (favs.size() < 7 || validFavoritoId(favs, 6))
        && (favs.size() < 8 || validFavoritoId(favs, 7))
        && (favs.size() < 9 || validFavoritoId(favs, 8))
        && (favs.size() < 10 || validFavoritoId(favs, 9));
    }

    function validEquiposFavoritosUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['equiposFavoritos']) || validFavoritosValue();
    }

    function coachSelfUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isCoordinador()
        ? changed.hasOnly(['nombre', 'equiposFavoritos'])
        : changed.hasOnly(['nombre', 'solicitudClubId', 'solicitudClubNombre', 'equiposFavoritos'])
          && !changed.hasAny(['clubId', 'clubNombre', 'rol']);
    }

    function validUserProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['nombre'])
        || (
          request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 80
        );
    }

    function validUserCreate() {
      let keys = request.resource.data.keys();
      return keys.hasOnly(['email', 'rol', 'creadoEn', 'nombre'])
        && request.resource.data.rol == 'entrenador'
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && (
          !keys.hasAny(['nombre'])
          || (
            request.resource.data.nombre is string
            && request.resource.data.nombre.size() > 0
            && request.resource.data.nombre.size() <= 80
          )
        );
    }

    match /Usuarios/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isSuperadmin()
        || (isCoachStaff() && resource.data.clubId == userClubId())
      );
      allow create: if isSignedIn() && request.auth.uid == userId && validUserCreate();
      allow update: if isSuperadmin() || (
        isSignedIn() && request.auth.uid == userId && coachSelfUpdateAllowed() && validUserProfileUpdate() && validEquiposFavoritosUpdate()
      ) || (
        isCoordinador()
        && resource.data.clubId == userClubId()
        && request.resource.data.clubId == resource.data.clubId
        && resource.data.rol != 'superadmin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equiposFavoritos'])
        && validFavoritosValue()
      );
      allow delete: if isSuperadmin();
    }

    match /Clubes/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSuperadmin();
      allow update: if isSuperadmin() || (
        isCoordinador()
        && userClubId() == clubId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logoUrl', 'logoSource', 'logoUpdatedAt'])
      );
      allow delete: if isSuperadmin();
    }

    match /Equipos/{equipoId} {
      allow read: if isSignedIn() && (isSuperadmin() || resource.data.clubId == userClubId());
      allow create: if isSignedIn() && canManageEquipoClub(request.resource.data.clubId);
      allow update: if canManageEquipoClub(resource.data.clubId)
        && canManageEquipoClub(request.resource.data.clubId);
      allow delete: if canManageEquipoClub(resource.data.clubId);
    }

    match /Jugadoras/{jugadoraId} {
      allow get: if isSignedIn() && (isSuperadmin() || canAccessEquipo(resource.data.equipoId));
      allow list: if isSignedIn() && (
        isSuperadmin()
        || resource.data.clubId == userClubId()
        || canAccessEquipo(resource.data.equipoId)
      );
      allow create: if isSignedIn() && (
        isSuperadmin() || (
          belongsToClub(request.resource.data.clubId)
          && canManagePlantillaEquipo(request.resource.data.equipoId)
        )
      );
      allow update: if isSignedIn() && (
        isSuperadmin() || (
          belongsToClub(resource.data.clubId)
          && canManagePlantillaEquipo(resource.data.equipoId)
          && request.resource.data.clubId == resource.data.clubId
          && canManagePlantillaEquipo(request.resource.data.equipoId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperadmin() || (
          belongsToClub(resource.data.clubId)
          && canManagePlantillaEquipo(resource.data.equipoId)
        )
      );
    }

    match /Sesiones/{sesionId} {
      allow read: if isSignedIn() && (isSuperadmin() || canAccessEquipo(resource.data.equipoId));
      allow create: if isSignedIn()
        && canAccessEquipo(request.resource.data.equipoId)
        && canWriteSesionTipo(sesionTipo(request.resource.data));
      allow update: if isSignedIn()
        && canAccessEquipo(resource.data.equipoId)
        && canAccessEquipo(request.resource.data.equipoId)
        && canWriteSesionTipo(sesionTipo(resource.data))
        && canWriteSesionTipo(sesionTipo(request.resource.data))
        && (
          !isPreparadorFisico()
          || (
            sesionTipo(resource.data) == 'fisico'
            && sesionTipo(request.resource.data) == 'fisico'
          )
        );
      allow delete: if isSignedIn()
        && canAccessEquipo(resource.data.equipoId)
        && canWriteSesionTipo(sesionTipo(resource.data));
    }

    match /Logos/{logoId} {
      allow read: if isSignedIn() && (
        isSuperadmin()
        || resource.data.tipo == 'club'
        || resource.data.clubId == userClubId()
      );
      allow create: if canWriteLogo(logoId);
      allow update: if canWriteLogo(logoId) && (
        isSuperadmin() || resource.data.clubId == userClubId()
      );
      allow delete: if isSuperadmin()
        || (isCoordinador() && resource.data.clubId == userClubId());
    }
  }
}
